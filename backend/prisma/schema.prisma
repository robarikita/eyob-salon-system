// backend/prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -----------------------------------------------------------------------------
// Enums
// -----------------------------------------------------------------------------

enum UserRole {
  OWNER
  BRANCH_ADMIN
  EMPLOYEE
  CUSTOMER
}

enum BookingStatus {
  PENDING_PAYMENT
  CONFIRMED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  NO_SHOW
  EXPIRED
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
  PARTIALLY_REFUNDED
}

enum PaymentMethod {
  CHAPA
  CASH
  MANUAL_CARD_POS
}

enum DepositType {
  FIXED
  PERCENTAGE
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

// -----------------------------------------------------------------------------
// Models
// -----------------------------------------------------------------------------

model User {
  id                   String    @id @default(uuid())
  firstName            String
  lastName             String
  email                String?   @unique
  phone                String    @unique
  password             String
  role                 UserRole  @default(CUSTOMER)
  passwordResetToken   String?   @unique
  passwordResetExpires DateTime?
  tokenVersion         Int       @default(0)
  
  // Relations
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])
  employee  Employee?
  bookings  Booking[] @relation("CustomerBookings")
  auditLogs AuditLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Branch {
  id               String   @id @default(uuid())
  name             String   @default("Addis Ababa Bole Bulbula")
  slug             String   @unique
  phoneNumber      String
  addressLine      String
  city             String   @default("Addis Ababa")
  isActive         Boolean  @default(true)
  slotBufferMinutes Int     @default(10) // e.g., 10 minutes between appointments
  
  // Relations
  users            User[]
  branchHours      BranchHours[]
  employees        Employee[]
  services         Service[]
  branchServices   BranchService[]
  bookings         Booking[]

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model BranchHours {
  id        String  @id @default(uuid())
  dayOfWeek Int     // 0 = Sunday, 1 = Monday, ..., 6 = Saturday
  openTime  String  // e.g., "08:00"
  closeTime String  // e.g., "18:00"
  isClosed  Boolean @default(false)
  
  // Relations
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, dayOfWeek])
}

model Employee {
  id                    String    @id @default(uuid())
  firstName             String
  lastName              String
  amharicName           String?
  phone                 String?
  email                 String?
  ritualTitle           String?
  employmentType        String?
  workstation           String?
  joinedDate            DateTime?
  emergencyContactName  String?
  emergencyContactPhone String?
  baseSalary            Decimal?  @db.Decimal(12, 2)
  commissionRate        Decimal?  @db.Decimal(5, 2)
  status                Boolean   @default(true) // Active or Inactive
  
  // Relations
  userId                String?   @unique
  user                  User?     @relation(fields: [userId], references: [id])
  branchId              String
  branch                Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  services              EmployeeService[]
  schedules             EmployeeSchedule[]
  scheduleExceptions    ScheduleException[]
  bookingItems          BookingItem[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
}

model EmployeeService {
  id                    String   @id @default(uuid())
  customDurationMinutes Int?
  customCommissionRate  Decimal? @db.Decimal(5, 2)
  
  // Relations
  employeeId            String
  employee              Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  serviceId             String
  service               Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([employeeId, serviceId])
}

model EmployeeSchedule {
  id             String   @id @default(uuid())
  dayOfWeek      Int      // 0-6
  startTime      String   // "08:00"
  endTime        String   // "17:00"
  breakStartTime String?
  breakEndTime   String?
  isWorking      Boolean  @default(true)

  // Relations
  employeeId     String
  employee       Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, dayOfWeek])
}

model ScheduleException {
  id         String    @id @default(uuid())
  date       DateTime  @db.Date
  endDate    DateTime? @db.Date
  reason     String?
  startTime  String?   // Optional: If working different hours
  endTime    String?   // Optional: If working different hours
  isWorking  Boolean   @default(false)

  // Relations
  employeeId String
  employee   Employee  @relation(fields: [employeeId], references: [id], onDelete: Cascade)
}

model Service {
  id                 String            @id @default(uuid())
  code               String            @unique
  name               String            @map("title")
  amharicName        String?
  category           String            @default("Hair Styling & Couture")
  subCategory        String?
  description        String?
  imageUrl           String?
  basePrice          Decimal           @map("price") @db.Decimal(10, 2)
  durationMinutes    Int               @map("duration") // Duration in minutes
  preSetupBuffer     Int               @default(0)
  turnaroundBuffer   Int               @default(15)
  workstationType    String?
  minGuildRank       String?
  requiresApprentice Boolean           @default(false)
  requiredProtocols  String[]
  standardCommission Decimal?          @db.Decimal(5, 2)
  depositType        DepositType       @default(FIXED)
  depositAmount      Decimal           @default(100) @db.Decimal(10, 2)
  isActive           Boolean           @default(true)

  // Relations
  branchId           String?
  branch             Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  branchServices     BranchService[]
  employees          EmployeeService[]
  bookingItems       BookingItem[]

  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
}

model BranchService {
  id                    String   @id @default(uuid())
  branchId              String
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  serviceId             String
  service               Service  @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  customPrice           Decimal? @db.Decimal(10, 2)
  customDurationMinutes Int?
  customTurnaround      Int?
  requiredDeposit       Decimal? @db.Decimal(12, 2)
  workstationLock       String?
  isActive              Boolean  @default(true)

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@unique([branchId, serviceId])
}

model Booking {
  id               String        @id @default(uuid())
  bookingNumber    String        @unique // Unique readable booking identifier (e.g., BK-12345)
  status           BookingStatus @default(PENDING_PAYMENT)
  totalAmount      Decimal       @db.Decimal(10, 2)
  depositRequired  Decimal       @db.Decimal(10, 2)
  depositPaid      Decimal       @default(0) @db.Decimal(10, 2)
  balanceDue       Decimal       @db.Decimal(10, 2)
  reservationExpires DateTime?   // Timestamp for slot holds
  notes            String?       // Customer notes & special requests
  cancellationReason String?     // Reason for cancellation or rejection
  
  // Relations
  customerId       String
  customer         User          @relation("CustomerBookings", fields: [customerId], references: [id])
  branchId         String
  branch           Branch        @relation(fields: [branchId], references: [id])
  
  items            BookingItem[]
  payments         Payment[]

  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
}

model BookingItem {
  id                    String   @id @default(uuid())
  
  // Snapshots (Immutable point-in-time)
  serviceTitleSnapshot  String
  priceSnapshot         Decimal  @db.Decimal(10, 2)
  durationSnapshot      Int      // Minutes
  depositSnapshot       Decimal  @db.Decimal(10, 2)
  
  startTime             DateTime
  endTime               DateTime

  // Relations
  bookingId             String
  booking               Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  serviceId             String?
  service               Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  employeeId            String?
  employee              Employee? @relation(fields: [employeeId], references: [id])
  
  review                Review?

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Payment {
  id                String        @id @default(uuid())
  amount            Decimal       @db.Decimal(10, 2)
  status            PaymentStatus @default(PENDING)
  method            PaymentMethod
  transactionRef    String?       @unique // E.g., Chapa transaction reference
  idempotencyKey    String?       @unique // Idempotency support

  // Relations
  bookingId         String
  booking           Booking       @relation(fields: [bookingId], references: [id])
  
  webhookLogs       PaymentWebhookLog[]

  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

model PaymentWebhookLog {
  id          String   @id @default(uuid())
  provider    String   // E.g., "CHAPA"
  payload     Json     // Provider payload storage
  processed   Boolean  @default(false)

  // Relations
  paymentId   String?
  payment     Payment? @relation(fields: [paymentId], references: [id])

  createdAt   DateTime @default(now())
}

model Review {
  id            String      @id @default(uuid())
  rating        Int         // 1-5
  comment       String?
  
  // Relations
  bookingItemId String      @unique
  bookingItem   BookingItem @relation(fields: [bookingItemId], references: [id], onDelete: Cascade)

  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model AuditLog {
  id        String      @id @default(uuid())
  action    AuditAction
  entity    String      // E.g., "Booking", "User"
  entityId  String      // ID of the affected entity
  details   Json?       // Changed fields, reasons, etc.

  // Relations
  userId    String?     // Who performed the action
  user      User?       @relation(fields: [userId], references: [id])

  createdAt DateTime    @default(now())
}
